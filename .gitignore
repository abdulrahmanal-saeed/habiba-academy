# Habiba Nabil Arabic Academy — .gitignore

# ── Environment files (NEVER commit) ──────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ── Firebase credentials (NEVER commit) ───────────────────────
backend/config/firebase-service-account.json

# ── Node.js ───────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ─────────────────────────────────────────────
dist/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ── PHP ───────────────────────────────────────────────────────
backend/vendor/
backend/composer.lock    # regenerate on deploy

# ── Uploads (user data, stays on server) ──────────────────────
backend/uploads/audio/
backend/uploads/reviews/
backend/uploads/materials/
backend/storage/

# ── Logs ──────────────────────────────────────────────────────
error_log
*.log
backend/error_log

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp

# ── Test artifacts ────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
